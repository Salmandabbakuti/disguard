{
  "name": "disguard-server-bun-react",
  "type": "module",
  "version": "1.8.0",
  "description": "DisGuard Server with Bun + React",
  "private": true,
  "keywords": [],
  "author": "Salman Dabbakuti",
  "license": "ISC",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.2.17"
  },
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "build": "bun build ./client/index.html --outdir=dist --sourcemap --target=browser --minify --define:process.env.NODE_ENV='\"production\"' --env='BUN_PUBLIC_*'",
    "start": "NODE_ENV=production bun src/index.ts",
    "typecheck": "tsc --noEmit",
    "contract:emit": "prisma contract emit"
  },
  "dependencies": {
    "@prisma/orm-postgres": "8.0.0-rc.12",
    "discord.js": "^14.27.0",
    "dotenv": "^18.0.5",
    "ethers": "^6.17.0",
    "jsonwebtoken": "^9.0.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@prisma/cli-engine": "0.6.2",
    "@types/bun": "^1.4.2",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prisma": "8.0.0-rc.18",
    "typescript": "^7.0.2"
  }
}
