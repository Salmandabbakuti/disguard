{
  "name": "disguard-server",
  "version": "1.7.0",
  "description": "DisGuard Server",
  "private": true,
  "keywords": [],
  "author": "Salman Dabbakuti",
  "license": "ISC",
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": ">=1.2.17"
  },
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "build": "bun build ./client/index.html --outdir=dist --sourcemap --target=browser --minify --define:process.env.NODE_ENV='\"production\"' --env='BUN_PUBLIC_*'",
    "start": "NODE_ENV=production bun src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "discord.js": "^14.27.0",
    "ethers": "^6.17.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "pg-hstore": "^2.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sequelize": "^6.37.8"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.6",
    "typescript": "^7.0.2"
  }
}
